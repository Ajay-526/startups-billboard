generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole { USER ADMIN }
enum SpotTier { HERO PRIME STANDARD }
enum SpotStatus { ACTIVE INACTIVE }
enum CampaignStatus { DRAFT PENDING_REVIEW APPROVED SCHEDULED LIVE COMPLETED CANCELLED }
enum CreativeStatus { PENDING APPROVED REJECTED }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  role UserRole @default(USER)
  companies CompanyUser[]
  campaigns Campaign[] @relation("CampaignOwner")
  events Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(cuid())
  name String
  slug String @unique
  logoUrl String?
  websiteUrl String?
  description String?
  accent String?
  users CompanyUser[]
  campaigns Campaign[]
  creatives Creative[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
}

model CompanyUser {
  userId String
  companyId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@id([userId, companyId])
  @@index([companyId])
}

model Spot {
  id String @id @default(cuid())
  slug String @unique
  position Int @unique
  tier SpotTier
  status SpotStatus @default(ACTIVE)
  name String
  description String?
  basePrice Decimal @db.Decimal(12, 2)
  campaigns Campaign[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tier, status])
}

model Campaign {
  id String @id @default(cuid())
  companyId String
  ownerId String
  spotId String
  status CampaignStatus @default(DRAFT)
  headline String
  subheadline String?
  startsAt DateTime
  endsAt DateTime
  totalAmount Decimal @db.Decimal(12, 2)
  company Company @relation(fields: [companyId], references: [id])
  owner User @relation("CampaignOwner", fields: [ownerId], references: [id])
  spot Spot @relation(fields: [spotId], references: [id])
  creatives Creative[]
  payments Payment[]
  events Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([spotId, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
  @@index([companyId])
}

model Creative {
  id String @id @default(cuid())
  companyId String
  campaignId String
  status CreativeStatus @default(PENDING)
  assetUrl String
  altText String
  metadata Json?
  company Company @relation(fields: [companyId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([campaignId, status])
}

model Payment {
  id String @id @default(cuid())
  campaignId String
  provider String
  providerId String? @unique
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(12, 2)
  currency String @default("INR")
  paidAt DateTime?
  metadata Json?
  campaign Campaign @relation(fields: [campaignId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([campaignId, status])
}

model Event {
  id String @id @default(cuid())
  type String
  userId String?
  campaignId String?
  path String?
  properties Json?
  occurredAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  @@index([type, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([userId, occurredAt])
}
