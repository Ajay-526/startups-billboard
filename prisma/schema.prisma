generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SpotTier {
  HERO
  PRIME
  STANDARD
}

enum SpotStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum CreativeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String?
  role         UserRole      @default(USER)
  companies    CompanyUser[]
  campaigns    Campaign[]    @relation("CampaignOwner")
  events       Event[]
  products     Product[]     @relation("ProductOwner")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Company {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  logoUrl     String?
  websiteUrl  String?
  description String?
  accent      String?
  users       CompanyUser[]
  campaigns   Campaign[]
  creatives   Creative[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
}

model CompanyUser {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

model Spot {
  id          String     @id @default(cuid())
  slug        String     @unique
  position    Int        @unique
  tier        SpotTier
  status      SpotStatus @default(ACTIVE)
  name        String
  description String?
  basePrice   Decimal    @db.Decimal(12, 2)
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tier, status])
}

model Campaign {
  id          String         @id @default(cuid())
  companyId   String
  ownerId     String
  spotId      String
  status      CampaignStatus @default(DRAFT)
  headline    String
  subheadline String?
  startsAt    DateTime
  endsAt      DateTime
  totalAmount Decimal        @db.Decimal(12, 2)
  company     Company        @relation(fields: [companyId], references: [id])
  owner       User           @relation("CampaignOwner", fields: [ownerId], references: [id])
  spot        Spot           @relation(fields: [spotId], references: [id])
  creatives   Creative[]
  payments    Payment[]
  events      Event[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([spotId, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
  @@index([companyId])
}

model Creative {
  id         String         @id @default(cuid())
  companyId  String
  campaignId String
  status     CreativeStatus @default(PENDING)
  assetUrl   String
  altText    String
  metadata   Json?
  company    Company        @relation(fields: [companyId], references: [id])
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([campaignId, status])
}

model Payment {
  id         String        @id @default(cuid())
  campaignId String
  provider   String
  providerId String?       @unique
  status     PaymentStatus @default(PENDING)
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("INR")
  paidAt     DateTime?
  metadata   Json?
  campaign   Campaign      @relation(fields: [campaignId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([campaignId, status])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String   @unique
  payload    Json
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt])
}

model Event {
  id         String    @id @default(cuid())
  type       String
  userId     String?
  campaignId String?
  path       String?
  properties Json?
  occurredAt DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([userId, occurredAt])
}

enum BoardType {
  ALL_TIME
  TODAY
  DAILY
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  url            String
  xHandle        String?
  description    String?
  categoryId     String
  ownerId        String?
  totalSpend     Decimal  @default(0) @db.Decimal(12, 2)
  firstClaimedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category      Category          @relation(fields: [categoryId], references: [id])
  owner         User?             @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contributions BidContribution[]
  dailySpend    DailySpend[]
  activities    Activity[]
  clicks        ProductClick[]

  @@index([categoryId, totalSpend])
  @@index([totalSpend, firstClaimedAt])
  @@index([ownerId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]

  @@index([name])
}

model BidContribution {
  id                String   @id @default(cuid())
  productId         String
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD")
  provider          String?
  providerPaymentId String?  @unique
  createdAt         DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([createdAt])
}

model DailySpend {
  id                  String   @id @default(cuid())
  productId           String
  day                 DateTime
  amount              Decimal  @default(0) @db.Decimal(12, 2)
  firstContributionAt DateTime
  updatedAt           DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, day])
  @@index([day, amount])
}

model Activity {
  id        String   @id @default(cuid())
  productId String
  type      String
  amount    Decimal? @db.Decimal(12, 2)
  rank      Int?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([productId, createdAt])
}

model ProductClick {
  id        String   @id @default(cuid())
  productId String
  path      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}
